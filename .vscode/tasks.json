{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: clang++ build example (all .cpp) and run",
            "command": "/bin/sh",
            "args": [
                "-c",
                "mkdir -p build && clang++ -std=c++23 -fcolor-diagnostics -g *.cpp -o build/main && ./build/main"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$clang++"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "type": "shell",
            "label": "Clean build dir",
            "command": "/bin/sh",
            "args": [
                "-c",
                "rm -R build"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Clean CMake build directory",
            "command": "/bin/sh",
            "args": [
                "-c",
                "rm -rf out"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared",
                "close": true
            }
        },
    ]
}