{
    // 🤖 Auto-configure IntelliSense for new files/folders
    "files.watcherExclude": {},
    // 🎯 Auto-run CMake configure when new .cpp files are added
    "cmake.configureOnOpen": true,
    "cmake.configureOnEdit": true,
    "cmake.automaticReconfigure": true,
    // 📁 Auto-refresh when workspace changes
    "explorer.autoReveal": true,
    // 🔄 Auto-restart clangd when compile_commands.json changes
    "clangd.detectExtensionConflicts": true,
    "clangd.checkUpdates": false,
    // 🎓 C++23 Learning Environment with clangd-only IntelliSense
    // 📝 File associations for C++23 learning
    "files.associations": {
        "*.cppm": "cpp",
        "*.ixx": "cpp",
        "*.pcm": "cpp",
        "array": "cpp",
        "atomic": "cpp",
        "bit": "cpp",
        "cctype": "cpp",
        "charconv": "cpp",
        "clocale": "cpp",
        "cmath": "cpp",
        "compare": "cpp",
        "concepts": "cpp",
        "cstdarg": "cpp",
        "cstddef": "cpp",
        "cstdint": "cpp",
        "cstdio": "cpp",
        "cstdlib": "cpp",
        "ctime": "cpp",
        "cwchar": "cpp",
        "cwctype": "cpp",
        "deque": "cpp",
        "string": "cpp",
        "unordered_map": "cpp",
        "vector": "cpp",
        "exception": "cpp",
        "algorithm": "cpp",
        "functional": "cpp",
        "iterator": "cpp",
        "memory": "cpp",
        "memory_resource": "cpp",
        "numeric": "cpp",
        "optional": "cpp",
        "random": "cpp",
        "string_view": "cpp",
        "system_error": "cpp",
        "tuple": "cpp",
        "type_traits": "cpp",
        "utility": "cpp",
        "format": "cpp",
        "initializer_list": "cpp",
        "iosfwd": "cpp",
        "iostream": "cpp",
        "istream": "cpp",
        "limits": "cpp",
        "new": "cpp",
        "numbers": "cpp",
        "ostream": "cpp",
        "print": "cpp",
        "span": "cpp",
        "stdexcept": "cpp",
        "streambuf": "cpp",
        "text_encoding": "cpp",
        "typeinfo": "cpp",
        "variant": "cpp",
        "ranges": "cpp",
        "coroutine": "cpp",
        "generator": "cpp",
        "expected": "cpp"
    },
    "// 🚫 CRITICAL: Disable Microsoft C++ IntelliSense": "",
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    "// 🚀 clangd Configuration - Our primary IntelliSense engine": "",
    "clangd.path": "/usr/bin/clangd-19",
    "clangd.arguments": [
        "--log=verbose",
        "--pretty",
        "--background-index",
        "--compile-commands-dir=/workspace/build",
        "--header-insertion=iwyu",
        "--completion-style=detailed",
        "--function-arg-placeholders",
        "--clang-tidy",
        "--pch-storage=memory",
        "--enable-config"
    ],
    "clangd.onConfigChanged": "restart",
    "clangd.restartAfterCrash": true,
    "// 🎯 Editor Configuration for Learning": "",
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.semanticHighlighting.enabled": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "// 🏗️ CMake Integration": "",
    "cmake.sourceDirectory": "/workspace",
    "cmake.buildDirectory": "/workspace/build",
    "cmake.generator": "Ninja",
    "cmake.buildTask": true
}